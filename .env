# Arquivo de variáveis de ambiente com dados sensíveis.
# NUNCA versionar este arquivo — ele já está listado no .gitignore.
# Use o .env.example como modelo para criar o seu próprio .env local.

# --- Banco de dados (Postgres compartilhado entre os serviços, um banco por serviço) ---
DB_USERNAME=siga
DB_PASSWORD=siga

# --- JWT: segredo compartilhado entre TODOS os serviços (gateway + microsserviços) ---
# Precisa ser o mesmo valor em todos, senão a validação do token falha entre serviços.
JWT_SECRET=c2lnYS10Y2MtMjAyNi1zZWNyZXQta2V5LW11c3QtYmUtYXQtbGVhc3QtMjU2LWJpdHM=
JWT_EXPIRATION=1800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8080
