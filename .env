spring.application.name=siga

# ===== PostgreSQL =====
spring.datasource.url=jdbc:postgresql://localhost:5432/sigadb
spring.datasource.username=siga
spring.datasource.password=troque_esta_senha
spring.datasource.driver-class-name=org.postgresql.Driver

# ===== JPA =====
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# ===== JWT =====
# Expiração em milissegundos (1800000 = 30 minutos)
jwt.secret=c2lnYS10Y2MtMjAyNi1zZWNyZXQta2V5LW11c3QtYmUtYXQtbGVhc3QtMjU2LWJpdHM=
jwt.expiration=1800000

# ===== Actuator =====
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=when-authorized

# ===== OpenAPI / Swagger =====
# Habilitar (true) apenas em desenvolvimento
springdoc.swagger-ui.enabled=false
springdoc.api-docs.enabled=false
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/api-docs

# ===== CORS =====
# Origens permitidas, separadas por vírgula
cors.allowed-origins=http://localhost:8080